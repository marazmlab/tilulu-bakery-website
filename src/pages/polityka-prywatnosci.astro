---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n/t";

const updatedAt = "19 czerwca 2026";

const sections = [
  {
    titleKey: "privacy.section.administrator.title",
    bodyKey: "privacy.section.administrator.body",
  },
  {
    titleKey: "privacy.section.scope.title",
    bodyKey: "privacy.section.scope.body",
  },
  {
    titleKey: "privacy.section.purpose.title",
    bodyKey: "privacy.section.purpose.body",
  },
  {
    titleKey: "privacy.section.legalBasis.title",
    bodyKey: "privacy.section.legalBasis.body",
  },
  {
    titleKey: "privacy.section.retention.title",
    bodyKey: "privacy.section.retention.body",
  },
  {
    titleKey: "privacy.section.rights.title",
    bodyKey: "privacy.section.rights.body",
  },
  {
    titleKey: "privacy.section.cookies.title",
    bodyKey: "privacy.section.cookies.body",
  },
] as const;
---

<BaseLayout
  title={t("privacy.meta.title")}
  description={t("privacy.meta.description")}
  ogImage="/images/og/privacy.jpg"
>
  <article>
    <p class="text-sm text-muted-foreground">
      {t("privacy.meta.updatedLabel")}: {updatedAt}
    </p>

    <h1 class="mt-6 text-3xl font-bold tracking-tight">
      {t("privacy.page.title")}
    </h1>

    <p class="mt-4 max-w-3xl text-muted-foreground">
      {t("privacy.intro.p1")}
    </p>

    {
      sections.map(({ titleKey, bodyKey }) => (
        <section class="mt-8">
          <h2 class="text-2xl font-semibold">{t(titleKey)}</h2>
          <p class="max-w-3xl text-muted-foreground">{t(bodyKey)}</p>
        </section>
      ))
    }

    <section id="zgody" class="mt-8 scroll-mt-8">
      <h2 class="text-2xl font-semibold">{t("privacy.section.consent.title")}</h2>
      <p class="max-w-3xl text-muted-foreground">
        {t("privacy.section.consent.body")}
      </p>
    </section>

    <p class="mt-8">
      <a href="/" class="font-medium text-primary hover:underline">
        {t("privacy.nav.home")}
      </a>
      {" · "}
      <a href="/kontakt" class="font-medium text-primary hover:underline">
        {t("privacy.nav.contact")}
      </a>
    </p>
    
  </article>
</BaseLayout>