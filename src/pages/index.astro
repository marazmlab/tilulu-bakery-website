---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StructuredData from "@/components/seo/StructuredData.astro";
import { t } from "@/i18n/t";
import { homeGallery } from "@/data/home-gallery";
import { site } from "@/lib/site";

const valueItemKeys = [
  "home.values.item1",
  "home.values.item2",
  "home.values.item3",
] as const;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: site.name,
  description: t("home.meta.description"),
  address: {
    "@type": "PostalAddress",
    addressLocality: site.location,
    addressCountry: "PL",
  },
  telephone: site.contact.phone,
  email: site.contact.email,
  sameAs: [site.social.instagram, site.social.facebook],
  image: new URL("/images/og/home.jpg", Astro.url.origin).href,
};

---

<BaseLayout 
  title={t("home.meta.title")}
  description={t("home.meta.description")}
  ogImage="/images/og/home.jpg"
>
  <StructuredData schema={localBusinessSchema} />
  <section class="space-y-6">
    <p class="text-sm font-medium text-primary">{t("home.hero.eyebrow")}</p>

    <h1 class="text-4xl font-bold sm:text-5xl">
      {t("home.hero.title")}
    </h1>

    <p class="max-w-2xl text-lg text-muted-foreground">
      {t("home.hero.description")}    
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/oferta"
        class="inline-flex h-10 items-center justify-center rounded-4xl bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80"
      >
        {t("home.cta.primary")}
      </a>

      <a 
        href="/zamowienia"
        class="inline-flex h-10 items-center justify-center rounded-4xl border border-border bg-input/30 px-5 text-sm font-medium transition-colors hover:bg-input/50"
      >
      {t("home.cta.secondary")}
      </a>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">{t("home.gallery.title")}</h2>
    <p class="mt-2 text-muted-foreground">
      {t("home.gallery.subtitle")}
    </p>

    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        homeGallery.map(({ src, altKey }) => (
          <li>
            <img
              src={src}
              alt={t(altKey)}
              width={800}
              height={600}
              loading="lazy"
              class="aspect-4/3 w-full rounded-xl border border-border object-cover"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">{t("home.values.title")}</h2>
    <p class="mt-2 max-w-2xl text-muted-foreground">{t("home.values.lead")}</p>

    <ul class="mt-6 space-y-3">
      {
        valueItemKeys.map((key) => (
          <li class="flex gap-3 text-foreground">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
            <span>{t(key)}</span>
          </li>
        ))
      }
    </ul>
  </section>

</BaseLayout>

