---
import { site } from "@/lib/site";
import { t } from "@/i18n/t";
import SocialLinks from "@/components/layout/SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border py-4">
  <div class="mx-auto max-w-5xl px-4 text-xs text-muted-foreground">
    <div class="flex flex-col items-center gap-3 text-center">

      <div
        class="flex flex-col items-center gap-2 md:flex-row sm:flex-wrap md:justify-center sm:gap-x-6 sm:gap-y-1"
      >
        <SocialLinks class="justify-center gap-2" />

        

        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1">
          <a
            href={`mailto:${site.contact.email}`}
            class="transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {site.contact.emailDisplay}
          </a>
          <a
            href={`tel:${site.contact.phone}`}
            class="transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {site.contact.phoneDisplay}
          </a>
        </div>
      </div>

      <nav
        aria-label="Linki prawne"
        class="flex flex-wrap justify-center gap-x-3 gap-y-1"
      >
        <a
          href="/regulamin"
          class="transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {t("footer.terms")}
        </a>
        <span class="text-border" aria-hidden="true">·</span>
        <a
          href="/polityka-prywatnosci"
          class="transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {t("footer.privacy")}
        </a>
        <span class="text-border" aria-hidden="true">·</span>
        <a
          href="/polityka-prywatnosci#zgody"
          class="transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          {t("footer.changeConsent")}
        </a>
      </nav>

      <p class="flex flex-col items-center gap-1 text-center text-muted-foreground md:flex-row md:flex-nowrap">
        <span class="font-medium text-foreground">{site.tagline}</span>
        <span class="hidden md:inline" aria-hidden="true"> · </span>
        <span>{t("footer.responseTime")}</span>
        <span class="hidden md:inline" aria-hidden="true"> · </span>
        <span>© {year} {site.legalName}. {t("footer.rights")}</span>
      </p>
    </div>
  </div>
</footer>

